//# sourceURL=elementor-pro-frontend-js-before </script> <style>  /* Existing styles remain the same */
 .custom-play-button {
 position: absolute;
 top: 50%;
 left: 50%;
 transform: translate(-50%, -50%);
 width: 80px;
 aspect-ratio: 1;
 cursor: pointer;
 z-index: 10;
 }
 .custom-controls {
 display: flex;
 gap: 4px;
 flex-direction: column;
 align-items: center;
 width: 100%;
 background-color: transparent;
 padding: 0 20px 8px 12px;
 position: absolute;
 bottom: 0;
 left: 0;
 z-index: 8;
 }
 .controls-row {
 display: flex;
 align-items: center;
 gap: 12px;
 width: 100%;
 }
 .play-btn {
 cursor: pointer;
 width: 16px;
 height: 16px;
 }
 .play-btn img {
 width: 100%;
 height: 100%;
 transition: opacity 0.3s ease;
 }
 .progress-bar {
 position: relative;
 width: 100%;
 height: 8px;
 background-color: rgba(255, 255, 255, 0.2);
 cursor: pointer;
 border-radius: 4px;
 }
 .progress {
 height: 100%;
 background-color: rgba(255, 255, 255, 0.5);
 width: 0;
 border-radius: 4px 0 0 4px;
 }
 .progress-thumb {
 position: absolute;
 top: 50%;
 width: 12px;
 height: 12px;
 background-color: #ffffff;
 border-radius: 50%;
 cursor: pointer;
 transform: translateY(-50%);
 }
 .time-container {
 display: flex;
 justify-content: space-between;
 width: 100%;
 font-size: 12px;
 font-weight: 600;
 color: #ffffff;
 }
 .time-container div {
 display: flex;
 flex-direction: row;
 align-items: center;
 gap: 16px;
 }
 .pause-icon {
 filter: invert(1);
 }
 /* New fullscreen styles */
 .fullscreen-btn {
 cursor: pointer;
 width: 16px;
 height: 16px;
 }
 .fullscreen-btn img {
 width: 16px;
 height: 16px;
 }
 .e-hosted-video {
 box-shadow: 0px 32px 64px -12px rgba(16, 24, 40, 0.14) !important;
 }
 /* Fullscreen mode styles */
 .video-container:-webkit-full-screen .custom-controls {
 padding: 0 40px 20px 32px;
 }
 .video-container:-webkit-full-screen .progress-bar {
 height: 12px;
 }
 .video-container:-webkit-full-screen .progress-thumb {
 width: 16px;
 height: 16px;
 }
 .video-container:-webkit-full-screen .play-btn,
 .video-container:-webkit-full-screen .fullscreen-btn {
 width: 24px;
 height: 24px;
 }
 .video-container:-webkit-full-screen .elementor-video {
 aspect-ratio: 21 / 9;
 height: 100% !important;
 width: auto;
 object-fit: contain;
} </style> <style> .custom-sticky-nav{
